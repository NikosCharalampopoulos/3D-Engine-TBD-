# Build output
build/
build-*/
out/
cmake-build-*/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
_deps/
Testing/

# Object / binary artifacts
*.o
*.obj
# ...except Wavefront OBJ 3D model assets (same ".obj" extension as a
# compiler object file, but a real committed asset here, not build output) --
# Phase 5's assets/models/*.obj test scenes must not be swept up by the rule
# above.
!assets/models/*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.exp
*.ilk
*.pdb

# Editor / OS cruft
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
.DS_Store

# Misc
*.log
