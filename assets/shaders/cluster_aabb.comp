#version 430 core

// Phase 13d: builds every cluster's view-space AABB -- see
// engine::ClusterLightCuller's header comment for the overall technique and
// why this dispatch only ever needs to run once (its output depends only on
// the projection matrix + screen size, never the view matrix). Standard
// Olsson/Assarsson-style clustered-shading AABB construction: each
// cluster's screen-space tile is unprojected to a view-space ray per
// corner, then intersected against that cluster's own near/far Z-slice
// planes to recover the 4 corners (2 screen corners x 2 depths) an AABB is
// built from.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Must match engine::ClusterLightCuller::kGridX/Y/Z (application.cpp/
// cluster_light_culler.hpp) and basic.frag/pbr.frag's own copies of these
// same three numbers -- hand-duplicated across every GLSL file that needs
// them, the same "no #include support" convention every other
// GLSL/C++-shared constant in this engine already follows (see
// application.cpp's MAX_POINT_LIGHTS comment).
const uint kGridX = 12u;
const uint kGridY = 8u;
const uint kGridZ = 24u;

struct ClusterAABB {
    vec4 minPoint;
    vec4 maxPoint;
};

layout(std430, binding = 0) buffer ClusterAABBBuffer {
    ClusterAABB clusters[];
};

// The camera's own inverse projection matrix (glm::inverse(projection),
// computed once on the CPU in ClusterLightCuller::computeClusterAABBs()) --
// used to unproject a screen-space pixel coordinate into a view-space point
// on the ray from the eye through that pixel.
uniform mat4 uInverseProjection;
uniform float uNearPlane;
// engine::ClusterLightCuller::kClusterFarDistance -- see that header's own
// comment on why this is deliberately much less than the camera's real far
// plane.
uniform float uFarPlane;
uniform vec2 uScreenSize;

// Unprojects a screen-space (pixel) coordinate at NDC z = -1 (GL's near
// plane in normalized device coordinates) into a view-space point on the
// ray from the eye (the view-space origin) through that pixel. Any point
// along that ray works for the line-plane intersection below -- z = -1 is
// simply a convenient, always-valid choice (it's always in front of the
// camera, unlike z = +1 which is the far plane and, for some projections,
// less numerically comfortable).
vec3 screenToView(vec2 screenPixel) {
    vec2 ndc = (screenPixel / uScreenSize) * 2.0 - 1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);
    vec4 view = uInverseProjection * clip;
    view /= view.w;
    return view.xyz;
}

// Intersects the ray from the view-space origin (the eye) through
// `viewSpacePoint` with the plane z = targetZ, both view-space. View space
// has the eye at the origin, so that ray is simply
// origin + t * viewSpacePoint for t in [0, inf) -- solving
// t * viewSpacePoint.z == targetZ for t and plugging back in gives the
// intersection directly, with no separate "ray origin" term needed.
vec3 lineIntersectionToZPlane(vec3 viewSpacePoint, float targetZ) {
    float t = targetZ / viewSpacePoint.z;
    return viewSpacePoint * t;
}

void main() {
    uvec3 gid = gl_GlobalInvocationID;
    if (gid.x >= kGridX || gid.y >= kGridY || gid.z >= kGridZ) {
        // Defensive: with kGridX/Y/Z all exact multiples of this shader's
        // own local_size_x/y/z (see ClusterLightCuller::computeClusterAABBs()'s
        // static_asserts), every dispatched invocation is always in-bounds
        // in practice -- kept anyway so this shader stays correct even if
        // those grid dimensions ever stop dividing evenly.
        return;
    }

    vec2 tileSize = uScreenSize / vec2(float(kGridX), float(kGridY));

    vec2 minTile = vec2(gid.xy) * tileSize;
    vec2 maxTile = vec2(gid.xy + uvec2(1u, 1u)) * tileSize;

    vec3 minTileView = screenToView(minTile);
    vec3 maxTileView = screenToView(maxTile);

    // Logarithmic Z-slicing (Olsson & Assarsson): solved here in the
    // "forward" direction (slice index -> its near/far view-space depth),
    // the exact inverse of basic.frag/pbr.frag's computeClusterZIndex()
    // (depth -> slice index) -- both must agree on the same formula for a
    // fragment's cluster assignment to actually match the cluster its own
    // AABB was built for.
    float clusterNear = uNearPlane * pow(uFarPlane / uNearPlane, float(gid.z) / float(kGridZ));
    float clusterFar = uNearPlane * pow(uFarPlane / uNearPlane, float(gid.z + 1u) / float(kGridZ));

    // View-space Z is negative in front of the eye (OpenGL convention);
    // clusterNear/clusterFar above are positive *distances*, so negate them
    // for the actual Z-plane values to intersect against.
    vec3 minNear = lineIntersectionToZPlane(minTileView, -clusterNear);
    vec3 minFar = lineIntersectionToZPlane(minTileView, -clusterFar);
    vec3 maxNear = lineIntersectionToZPlane(maxTileView, -clusterNear);
    vec3 maxFar = lineIntersectionToZPlane(maxTileView, -clusterFar);

    vec3 aabbMin = min(min(minNear, minFar), min(maxNear, maxFar));
    vec3 aabbMax = max(max(minNear, minFar), max(maxNear, maxFar));

    uint index = gid.x + gid.y * kGridX + gid.z * kGridX * kGridY;
    clusters[index].minPoint = vec4(aabbMin, 0.0);
    clusters[index].maxPoint = vec4(aabbMax, 0.0);
}
